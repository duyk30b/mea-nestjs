{
  "files.autoSave": "off",
  "files.eol": "\n",
  "explorer.compactFolders": false,
  "editor.tabSize": 2,
  "editor.wordWrap": "off",
  "editor.inlayHints.fontSize": 10,
  "editor.suggest.insertMode": "replace",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "window.title": "${rootName}",
  "workbench.colorCustomizations": {
    "editorInlayHint.background": "#4d4d4d99",
    "editorInlayHint.foreground": "#ffffffcc"
  },
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.tree.indent": 16,
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": [
      "source.sortImports",
      "source.formatDocument",
      "source.fixAll.eslint"
    ]
  },
  "search.smartCase": true,
  "search.exclude": {
    "**/dist": true,
    "**/data": true,
    "**/node_modules": true,
  },
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.format.semicolons": "remove",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "git.allowForcePush": true,
  "cSpell.language": "en,vi",
  "cSpell.words": [
    "adminer",
    "bignumber",
    "bitnami",
    "CĐHA",
    "certbot",
    "datetime",
    "dpage",
    "exceljs",
    "Fastify",
    "jdbc",
    "kafkajs",
    "letsencrypt",
    "middie",
    "nats",
    "nestjs",
    "Partitioner",
    "Partitioners",
    "pgadmin",
    "Putaway",
    "redisinsight",
    "redislabs",
    "redlock",
    "taskkill",
    "typeorm",
    "Upserted",
    "virtuals",
    "websockets",
    "zalo"
  ],
}